# macOS Finder metadata
.DS_Store
._*
Thumbs.db

# Editor / IDE
*.code-workspace

# ============================================================
# Cinefex content tree
# ============================================================
# Issue HTML trees are too large for git and are deployed as a
# bind-mount at runtime (see unraid/cinefex-online.xml). Cover
# images (covers/) ARE committed — they ship baked into the
# Docker image so the runtime can serve them.
issues/

# Generated data files.
# - public/issues.json / public/issues_full.json: hand-curated metadata
#   for all 169 issues. Committed to git; edit them directly for
#   targeted corrections. The cinefex run is finite (the magazine is
#   cancelled), so we don't need to rebuild these.
# - public/search_index.json: derived from article full-text and
#   rebuilt on demand via `npm run build:search-index` (the pure-JS
#   `scripts/build-search-index.mjs` script). Not committed because
#   it's ~16 MB; the Docker build regenerates it so the runtime
#   image is always in sync with the committed JSON.
# - public/search_index.json.gz: pre-compressed copy for servers that
#   negotiate Content-Encoding. Not committed; written alongside the
#   raw JSON by the same build script.
public/search_index.json
public/search_index.json.gz
!public/issues.json
!public/issues_full.json

# ============================================================
# Build artifacts
# ============================================================
node_modules/
dist/
*.tsbuildinfo

# Auth credentials (server-only)
cinefex.htpasswd

# Deployment-specific Apache config (servers read .htaccess by default;
# the repo ships the template as .htaccess.example, which IS committed).
.htaccess

# Tooling state
.opencode
.idea/
.vscode/

# ============================================================
# Historical artifacts (no longer used by the app)
# ============================================================
# The unused GillSans-Bold fallback was the only .tt file in the
# fonts/ tree. The repo-standard extension is .ttf. Once the rename
# is committed, this rule is harmless; it prevents any future .tt
# from sneaking back in.
*.tt

# ============================================================
# Local dev mount points (docker-compose.yml)
# ============================================================
.docker-issues/
