{
    "name": "cinefex-online",
    "version": "2.0.0",
    "description": "A web front end to access the archive of Cinefex magazines. This project provides an interactive interface to browse and view digitized issues of Cinefex magazine, including both reading-optimized and archival layout views.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "covers:webp": "node scripts/convert-covers-to-webp.js",
        "covers:webp:check": "node scripts/convert-covers-to-webp.js --check",
        "search:index": "python3 create_json.py",
        "build": "npm run covers:webp && npm run search:index && tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.html\"",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DJCallyman/Cinefex-Online.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/DJCallyman/Cinefex-Online/issues"
    },
    "homepage": "https://github.com/DJCallyman/Cinefex-Online#readme",
    "dependencies": {
        "minisearch": "^7.2.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.1.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@tailwindcss/postcss": "^4.2.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/jsdom": "^28.0.3",
        "@types/node": "^25.9.1",
        "@types/react": "^19.0.1",
        "@types/react-dom": "^19.0.1",
        "@typescript-eslint/eslint-plugin": "^8.57.1",
        "@typescript-eslint/parser": "^8.57.1",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/ui": "^4.1.8",
        "autoprefixer": "^10.4.24",
        "eslint": "^9.18.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^15.14.0",
        "jsdom": "^29.1.1",
        "postcss": "^8.5.6",
        "prettier": "^3.8.1",
        "tailwindcss": "^4.2.0",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.20.0",
        "vite": "^6.0.7",
        "vitest": "^4.1.8"
    }
}
