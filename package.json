{
    "name": "cinefex-online",
    "version": "2.0.0",
    "description": "A web front end to access the archive of Cinefex magazines. This project provides an interactive interface to browse and view digitized issues of Cinefex magazine, including both reading-optimized and archival layout views.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.html\"",
        "typecheck": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DJCallyman/Cinefex-Online.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/DJCallyman/Cinefex-Online/issues"
    },
    "homepage": "https://github.com/DJCallyman/Cinefex-Online#readme",
    "dependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.1.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@tailwindcss/postcss": "^4.2.0",
        "@types/react": "^19.0.1",
        "@types/react-dom": "^19.0.1",
        "@typescript-eslint/eslint-plugin": "^8.57.1",
        "@typescript-eslint/parser": "^8.57.1",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.24",
        "eslint": "^9.18.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^15.14.0",
        "postcss": "^8.5.6",
        "prettier": "^3.8.1",
        "tailwindcss": "^4.2.0",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.20.0",
        "vite": "^6.0.7",
        "vite-plugin-pwa": "^0.21.1"
    }
}
