# ============================================================
# Cinefex Archives - Apache Server Configuration
# ============================================================

# --- Security Headers ---
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https://placehold.co; frame-src 'self'; connect-src 'self';"

    # HTTPS enforcement (uncomment for production)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- HTTP Basic Authentication ---
<IfModule mod_authn_core.c>
    AuthType Basic
    AuthName "Cinefex Archives"
    AuthUserFile /path/to/cinefex.htpasswd
    Require valid-user
</IfModule>

# --- Caching ---
<IfModule mod_expires.c>
    ExpiresActive On

    # Fonts: cache for 1 year
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType font/truetype "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Images: cache for 1 month
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"

    # CSS/JS: cache for 1 week
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"

    # HTML: cache for 1 hour
    ExpiresByType text/html "access plus 1 hour"

    # JSON: cache for 1 day
    ExpiresByType application/json "access plus 1 day"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
    AddOutputFilterByType DEFLATE font/opentype font/truetype
</IfModule>

# --- MIME Types ---
<IfModule mod_mime.c>
    AddType font/opentype .otf
    AddType font/truetype .tt .ttf
    AddType application/json .json
</IfModule>

# --- Prevent access to sensitive files ---
<FilesMatch "\.(htpasswd|gitignore|md|py)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
